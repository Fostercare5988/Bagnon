<Bindings>
	<Binding name="BAGNON_TOGGLE" description="Toggle Inventory" header="BAGNON">
		BagnonFrame_Toggle("Bagnon");
	</Binding>
	<Binding name="BANKNON_TOGGLE" description="Toggle Bank">
		BagnonFrame_Toggle("Banknon");
	</Binding>
	<Binding name="BAGNON_SORT" description="Sort Bags">
		if C_Container and C_Container.SortBags then PlaySound("igMainMenuOption"); C_Container.SortBags(); end
	</Binding>
</Bindings>